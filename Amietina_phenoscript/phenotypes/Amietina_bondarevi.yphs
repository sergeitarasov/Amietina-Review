
# Description of Amietina bondarevi Montanaro & Tarasov, n. sp. based on the male holotype


OTU = { #// OTUName:  Amietina bondarevi

    DATA = {
        
        #>>>YAML new_species
        new_species:
            .id: amietina_bondarevi
            .rdfs-label: 'Amietina bondarevi'
            .zoobank_id: 'http://zoobank.org/urn:lsid:zoobank.org:act:D72572AB-394E-4DCC-8BD8-ABA15B1D262F'
            .dwc-Parent_Name_Usage_ID: 'https://www.gbif.org/taxon/62996'
            .dwc-Catalog_Number:
                - 'http://id.luomus.fi/GAC.37187'  #/ change to valid one
            .is_a:
                - uberon-male_organism
                - uberon-adult_organism
                - dwc-Preserved_Specimen
        #<<<YAML

    }

  TRAITS = {
    
    #--------
    # Body.
    #--------
  
    # Body lenticular, integument light pinkish cupreous, shiny, covered with pale yellowish setae.
    this >> (pato-ovate, pato-pink, pato-glistening);
    this > aism-insect_region_of_cuticle -> uberon-anatomical_collection .ro-has_member aism-cuticular_seta >> pato-light_yellow; 

    # Length: 3.0 mm.
    #>>>YAML absolute_measurement
    absolute_measurement:
        .measured_entity: this
        .measured_quality: pato-length
        .value: 3.0
        .unit: unit-millimeter
    #<<<YAML
    

    #--------
    #Head.
    #--------

    # Subpentagonal, tapering anteriorly;
    this > aism-insect_head:id-033849 >> pato-pentagonal;
        aism-insect_head:id-033849 > bspo-anterior_region >> pato-attenuate;
    
    # anterior margin of clypeus with two teeth separated by an obtuse notch;
        aism-insect_head:id-033849 > aism-clypeus > bspo-anterior_margin:id-c62f0f > aism-cuticular_tooth >> pato-bilaterally_paired;
        bspo-anterior_margin:id-c62f0f > aism-obtusely_notched;

    # clypeal margin very feebly sinuated at clypeogenal junction;
        aism-insect_head:id-033849 > bspo-antero-lateral_margin:id-24b5e8 .ro-adjacent_to colao-genoclypeal_sulcus;
        bspo-antero-lateral_margin:id-24b5e8 >> pato-curved .ro-has_modifier pato-decreased_magnitude;

    # entirely covered with simple punctures of uneven size, punctures smaller anteromedially;
        aism-insect_head:id-033849 > uberon-anatomical_collection .ro-has_member aism-cuticular_puncture;
        aism-insect_head:id-033849 > bspo-antero-medial_region > uberon-anatomical_collection .ro-has_member aism-cuticular_puncture >> pato-decreased_size;
    
    # punctures separated by approximately 1-2 diameters anteriorly, denser posteriorly.
        #>>>YAML relative_measurement
        relative_measurement:
          .measured_trait: 
            .entity: uberon-anatomical_collection:id-912b78 < bspo-anterior_region < aism-insect_head:id-033849
            .quality: aism-interpunctural_distance:id-012c4b
          .unit:
            .entity: aism-cuticular_puncture .ro-member_of uberon-anatomical_collection:id-912b78
            .quality: pato-diameter
          .value: 1.5
        #<<<YAML
        aism-insect_head:id-033849 > bspo-posterior_region >> aism-interpunctural_distance |>| aism-interpunctural_distance:id-012c4b;

    # Frons bearing a short transverse carina approximately as long as 1/3 of interocular distance, placed between the anterior margins of eyes.
        aism-insect_head:id-033849 > aism-frons > aism-cuticular_carina:id-24d008 >> (pato-straight, pato-transverse_orientation);
        aism-cuticular_carina:id-24d008 .ro-coincident_with caro-anatomical_line:id-694058 .ro-connects bspo-anterior_margin < aism-eye_cuticle < bspo-left_side < aism-insect_head:id-033849;
        caro-anatomical_line:id-694058 .ro-connects bspo-anterior_margin < aism-eye_cuticle < bspo-right_side < aism-insect_head:id-033849;
    # Antennae with 8 segments.
        aism-insect_head:id-033849 > aism-antenna > aism-antennomere .phs-has_element_count 8;

    
    #--------
    #Pronotum.
    #--------

    # Pronotum subtrapezoidal (maximum width in correspondence of posterolateral angles);
    this > aism-pronotum:id-4e6a38 >> pato-trapezoid;
    
    #base finely bordered;
        aism-pronotum:id-4e6a38 > bspo-posterior_margin .ro-adjacent_to aism-cuticular_groove < aism-pronotum:id-4e6a38;

    # posterolateral angles sinuated in lateral view; #/ check!!
        aism-pronotum:id-4e6a38 > bspo-postero-lateral_margin >> pato-curved;

    # covered with sparse simple setigerous punctures intermixed with smaller ones, 
        aism-pronotum:id-4e6a38 > uberon-anatomical_collection:id-32d798 .ro-has_member aism-simple_setigerous_cuticular_puncture:id-5779b8;
        aism-pronotum:id-4e6a38 > uberon-anatomical_collection:id-d08d08 .ro-has_member aism-simple_setigerous_cuticular_puncture:id-a14c98;
        aism-simple_setigerous_cuticular_puncture:id-5779b8 >> pato-diameter:id-64eb88 |>| pato-diameter << aism-simple_setigerous_cuticular_puncture:id-a14c98;

    # the largest ones separated by approximately 3 diameters on disc.

        #>>>YAML relative_measurement
        relative_measurement:
          .measured_trait:
            .entity: uberon-anatomical_collection:id-32d798
            .quality: aism-interpunctural_distance
          .unit:
            .entity: aism-simple_setigerous_cuticular_puncture:id-5779b8
            .quality: pato-diameter:id-64eb88
          .value: 3
        #<<<YAML


    #--------
    #Elytra and wings.
    #--------

    # Wider than pronotum;
    this > colao-elytron:id-d1df04 >> pato-width |>| pato-width:id-db5ade << aism-pronotum:id-4e6a38;
    
    # striae clearly impressed, in number of 8;
        colao-elytron:id-d1df04 > uberon-anatomical_collection .ro-has_member colao-elytral_stria:id-f09fcd >> pato-increased_depth;
        colao-elytral_stria:id-f09fcd .phs-has_element_count 8;

    # strial punctures larger than strial width;
        colao-elytral_stria:id-f09fcd > aism-simple_setigerous_cuticular_puncture >> pato-diameter |>| pato-width << colao-elytral_stria:id-f09fcd; 
    
    # interstriae with scattered simple setigerous punctures;
        colao-elytron:id-d1df04 > colao-elytral_disc > uberon-anatomical_collection .ro-has_member colao-elytral_interstria > uberon-anatomical_row:id-b1bc78 .ro-has_member aism-simple_setigerous_cuticular_puncture;
    
    # metathoracic scutellum absent.
    this > aism-metathorax !> aism-scutellum;

    # Metathoracic wings fully developed.
    this > aism-hind_wing;

    
    #--------
    #Tergite VIII.
    #--------

    # Cuticular punctures simple, deep, separated by approximately 1 diameter; #/ check!!!
    this > aism-abdominal_tergite_VIII:id-075e68 > uberon-anatomical_collection:id-809528 .ro-has_member aism-simple_setigerous_cuticular_puncture:id-576bc8 >> pato-increased_depth;
       
        #>>>YAML relative_measurement
        relative_measurement:
          .measured_trait:
            .entity: uberon-anatomical_collection:id-809528
            .quality: aism-interpunctural_distance
          .unit:
            .entity: aism-simple_setigerous_cuticular_puncture:id-576bc8
            .quality: pato-diameter
          .value: 1
        #<<<YAML

    # surface between punctures glossy. #/ check!!!
        aism-abdominal_tergite_VIII:id-075e68 >> pato-glistening;
    

    #--------
    #Ventral body surface.
    #--------
    
    # Anterior region of hypomera concave; #/ check!!!
    this > colao-hypomeron:id-ec9838 > bspo-anterior_region:id-eba2c8 >> pato-concave;
    
    # anterior hypomeral carina directed toward lateral pronotal edge before curving toward anterior angle; #/ check!!!
        bspo-anterior_region:id-eba2c8 > aism-cuticular_carina >> (pato-curved, pato-lateral_orientation);

    # posterior longitudinal hypomeral carina absent. #/ check!!!
        colao-hypomeron:id-ec9838 > bspo-posterior_region !> aism-cuticular_carina;


    #--------
    #Legs.
    #--------

    # Protibiae with three external teeth;
    this > aism-protibia:id-1bcc18 > aism-cuticular_tooth .phs-has_element_count 3;

    # distal margin oblique, with an uncus.
        aism-protibia:id-1bcc18 > bspo-distal_margin:id-0e33d8 >> pato-oblique_orientation;
        bspo-distal_margin:id-0e33d8 > colao-uncus;
        
    # Anteroventral carina of profemora entire. #/ check!!!
    this > aism-profemur > bspo-antero-ventral_region > aism-cuticular_carina >> pato-continuous;

    
    #--------
    #Genitalia.
    #--------
        
    # Parameres symmetrical, relatively short, as long as 0.66 times phallobase length;
    this > aism-parameres:id-bf6f3c >> (pato-shortened, pato-symmetrical);
        #>>>YAML relative_measurement
        relative_measurement:
          .measured_trait:
            .entity: aism-parameres:id-bf6f3c
            .quality: pato-length
          .unit:
            .entity: aism-phallobase < this
            .quality: pato-length
          .value: 0.66
        #<<<YAML

    # apices sharp and strongly bent ventrally in lateral view;
        aism-parameres:id-bf6f3c > bspo-postero-ventral_region >> (pato-sharp, pato-ventral_orientation);

    # ventral margin of paramere feebly curved in lateral view;
        aism-parameres:id-bf6f3c > bspo-ventral_margin >> pato-concave .ro-has_modifier pato-decreased_magnitude;
    
    # apices slightly bulging laterally in frontal view.
        aism-parameres:id-bf6f3c > bspo-postero-ventral_region >> pato-protruding;

    # Endophallus without evident raspulae; 
    this > aism-endophallus:id-4caf81 !> colao-raspula;
    
    # lamella copulatrix present, composed of 2 sclerites (presence of a third small sclerite cannot be excluded but unclear due to poor sclerification of the structures).
        aism-endophallus:id-4caf81 > colao-lamella_copulatrix > aism-endophallite .phs-has_element_count 2;
    
    }

}